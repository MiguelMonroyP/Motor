<style>
/* Layout: banco de trabajo 3D a todo el ancho con el panel de la ley activa a la derecha; debajo, la tabla del
   recorrido de cada magnitud. Paleta del curso: cobre como acento, fases RETIE y colores fijos por tipo de vector. */
:root {
  --bg: #EEF1F4; --panel: #FFFFFF; --panel-2: #F5F7F9; --ink: #15202B; --muted: #566577; --line: #D3DBE3;
  --copper: #B4621C; --copper-soft: #F6E7D8; --stage: #E3E8EE; --stage-2: #CDD5DE;
  --phase-a: #C99500; --phase-b: #1F5FBF; --phase-c: #C72F2F;
  --v-n: #E0742A; --v-s: #138C95; --v-emf: #7A45D6; --v-force: #1F8F4E; --v-tau: #2F6690; --v-rel: #6B7785; --v-flux: #3A4652; --v-cur: #9B5CF0;
  --m-paint: #50687F; --m-lam: #8C97A2; --m-copper: #B8733A; --m-alu: #C7CDD3; --m-shaft: #AEB6BE; --m-cut: #E2B47C; --m-dark: #3B434C;
  --display: "Barlow Condensed", "Arial Narrow", "Roboto Condensed", sans-serif;
  --body: "Source Sans 3", "Segoe UI", system-ui, sans-serif;
  --mono: "JetBrains Mono", "Consolas", "SFMono-Regular", monospace;
  --math: "STIX Two Text", "Cambria Math", "Times New Roman", serif;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #0E141A; --panel: #151E27; --panel-2: #1A2530; --ink: #E5ECF2; --muted: #93A3B4; --line: #2A3845;
  --copper: #E38B3E; --copper-soft: #3A2817; --stage: #0B1117; --stage-2: #1C2733;
  --phase-a: #F1C232; --phase-b: #5F9DF2; --phase-c: #F26560;
  --v-n: #F38E44; --v-s: #3CBAC1; --v-emf: #A98BF5; --v-force: #4FD486; --v-tau: #6FA8D6; --v-rel: #A3B0BE; --v-flux: #D5DEE7; --v-cur: #C3A6FF; color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #0E141A; --panel: #151E27; --panel-2: #1A2530; --ink: #E5ECF2; --muted: #93A3B4; --line: #2A3845;
  --copper: #E38B3E; --copper-soft: #3A2817; --stage: #0B1117; --stage-2: #1C2733;
  --phase-a: #F1C232; --phase-b: #5F9DF2; --phase-c: #F26560;
  --v-n: #F38E44; --v-s: #3CBAC1; --v-emf: #A98BF5; --v-force: #4FD486; --v-tau: #6FA8D6; --v-rel: #A3B0BE; --v-flux: #D5DEE7; --v-cur: #C3A6FF; color-scheme: dark }

* { box-sizing: border-box }
[hidden] { display: none !important }
body { background: var(--bg); color: var(--ink); font: 400 16px/1.55 var(--body);
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 20px 48px }
.wrap { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px }
h1, h2, h3 { font-family: var(--display); font-weight: 600; margin: 0; text-wrap: balance; letter-spacing: .01em; line-height: 1.05 }
h1 { font-size: clamp(32px, 4.4vw, 48px) }
h2 { font-size: 26px } h3 { font-size: 19px }
p { margin: 0 }
.eyebrow { font: 600 12px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--copper) }
.lede { color: var(--muted); max-width: 75ch }
.m { font-family: var(--math); font-size: 1.07em }
.m i, .eq i { font-style: italic }
button:focus-visible, input:focus-visible, select:focus-visible, .part-chip:focus-visible { outline: 2px solid var(--copper); outline-offset: 2px }

.steps { display: flex; flex-wrap: wrap; gap: 6px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 5px }
.steps button { flex: 1 1 auto; font: 600 15px/1.2 var(--body); color: var(--muted); background: none; border: 0; padding: 9px 14px; border-radius: 8px; cursor: pointer; display: flex; gap: 8px; align-items: center; justify-content: center }
.steps button .n { font: 600 12px var(--mono); width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid currentColor }
.steps button[aria-selected="true"] { background: var(--ink); color: var(--bg) }

.bench { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 18px; align-items: start }
.viewer { border-radius: 14px; overflow: hidden; background: var(--stage); border: 1px solid var(--line); height: clamp(500px, 78vh, 840px); display: flex; flex-direction: column }
.stage3d { position: relative; flex: 1 1 auto; min-height: 0; touch-action: none }
.stage3d canvas { display: block; width: 100%; height: 100% }
.labels { position: absolute; inset: 0; pointer-events: none; overflow: hidden }
.lbl { position: absolute; left: 0; top: 0; white-space: nowrap; font: 600 12.5px/1.2 var(--body); padding: 4px 8px; border-radius: 6px; background: var(--panel); color: var(--ink);
  border: 1.5px solid var(--c, var(--line)); box-shadow: 0 1px 3px rgba(0,0,0,.12); will-change: transform }
.lbl.part { pointer-events: auto; cursor: pointer }
.lbl.part.sel { background: var(--copper); color: #fff; border-color: var(--copper) }
.lbl.vec { font: 600 13px/1.1 var(--math); font-style: italic; color: var(--c); background: color-mix(in srgb, var(--panel) 88%, transparent) }
.hud { flex: 0 0 auto; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; background: var(--panel); border-top: 1px solid var(--line); padding: 9px 12px; font-size: 13.5px }
.hud label { display: inline-flex; align-items: center; gap: 6px; font-weight: 600 }
.hud input[type="range"] { width: 130px; accent-color: var(--copper) }
.hud select { font: 500 13px var(--body); padding: 3px 6px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel-2); color: var(--ink) }
.btn { font: 600 13.5px var(--body); padding: 6px 11px; border-radius: 7px; border: 1px solid var(--line); background: var(--panel-2); color: var(--ink); cursor: pointer }
.btn.primary { background: var(--ink); color: var(--bg); border-color: var(--ink) }
.hint { position: absolute; top: 10px; left: 12px; font-size: 12.5px; color: var(--muted); background: color-mix(in srgb, var(--panel) 85%, transparent); padding: 4px 8px; border-radius: 6px; pointer-events: none }
.clock { position: absolute; top: 10px; right: 12px; font: 600 12px var(--mono); color: var(--muted); background: color-mix(in srgb, var(--panel) 85%, transparent); padding: 4px 8px; border-radius: 6px; pointer-events: none }
.nogl { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; color: var(--muted) }

.side { display: grid; gap: 14px; min-width: 0 }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: grid; gap: 10px; min-width: 0 }
.card .tag { font: 600 11.5px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--copper) }
.where { border-left: 3px solid var(--copper); padding: 4px 0 4px 12px; font-size: 15px }
.eq { font-family: var(--math); font-size: 22px; padding: 10px 14px; background: var(--panel-2); border: 1px solid var(--line); border-radius: 8px; overflow-x: auto; white-space: nowrap }
.eq small { font: 500 12px var(--body); color: var(--muted); display: block; white-space: normal; margin-top: 2px }
.legend { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; font-size: 14px; line-height: 1.35 }
.legend li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 8px; align-items: start }
.sw { width: 26px; height: 10px; border-radius: 3px; margin-top: 5px; background: var(--c); position: relative }
.sw.arrow::after { content: ""; position: absolute; right: -6px; top: -4px; border-left: 8px solid var(--c); border-top: 9px solid transparent; border-bottom: 9px solid transparent }
.sw.dot { width: 10px; height: 10px; border-radius: 50%; margin-left: 8px }
.nums { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px }
.nums div { background: var(--panel-2); border: 1px solid var(--line); border-radius: 7px; padding: 6px 9px; min-width: 0 }
.nums dt { font-size: 12px; color: var(--muted) } .nums dd { margin: 0; font: 600 15px var(--mono); white-space: nowrap }
.note { font-size: 13.5px; color: var(--muted) }
.parts { display: flex; flex-wrap: wrap; gap: 6px }
.part-chip { font: 600 12.5px var(--body); padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel-2); color: var(--ink); cursor: pointer }
.part-chip[aria-pressed="true"] { background: var(--copper); border-color: var(--copper); color: #fff }
.part-info h3 { font-size: 20px }
.part-info dl { margin: 0; display: grid; gap: 6px; font-size: 14.5px }
.part-info dt { font-weight: 700; font-size: 12.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em }
.part-info dd { margin: 0 }

.route { overflow-x: auto; background: var(--panel); border: 1px solid var(--line); border-radius: 12px }
table { border-collapse: collapse; width: 100%; min-width: 860px; font-size: 14.5px }
th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top }
tr:last-child td { border-bottom: 0 }
th { font: 600 11.5px var(--mono); letter-spacing: .07em; text-transform: uppercase; color: var(--muted); background: var(--panel-2) }
td.sym { font-family: var(--math); font-style: italic; font-size: 19px; white-space: nowrap }
td.sym .sw { display: inline-block; vertical-align: middle; margin: 0 8px 0 0 }

@media (max-width: 1100px) { .bench { grid-template-columns: minmax(0, 1fr) } .side { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)) } }
@media (max-width: 640px) { .viewer { height: 74vh; min-height: 520px } .steps button { flex: 1 1 40%; font-size: 14px; padding: 8px } .hud input[type="range"] { width: 100px } .hint { display: none } }
</style>

<div class="wrap">
  <header style="display:grid;gap:8px">
    <div class="eyebrow">Campos Electromagnéticos · Motor de inducción trifásico · 4 polos, 220 V, 60 Hz</div>
    <h1>Explosionado del motor</h1>
    <p class="lede">Un motor real separado pieza por pieza. Recorra las tres leyes en orden y vea en qué parte ocurre cada una, por dónde circula cada magnitud y hacia dónde apunta cada vector.</p>
  </header>

  <div class="steps" role="tablist" aria-label="Recorrido">
    <button role="tab" id="st-despiece" data-step="despiece" aria-selected="true"><span class="n">0</span>Despiece</button>
    <button role="tab" id="st-ampere" data-step="ampere" aria-selected="false"><span class="n">1</span>Ampère: la corriente crea el campo</button>
    <button role="tab" id="st-faraday" data-step="faraday" aria-selected="false"><span class="n">2</span>Faraday: el campo induce en el rotor</button>
    <button role="tab" id="st-lorentz" data-step="lorentz" aria-selected="false"><span class="n">3</span>Lorentz: fuerza y par</button>
    <button role="tab" id="st-todo" data-step="todo" aria-selected="false"><span class="n">∑</span>Todo junto</button>
  </div>

  <div class="bench">
    <div class="viewer">
      <div class="stage3d" id="viewer">
        <div class="labels" id="labels"></div>
        <div class="hint" id="hint">Arrastre para girar · rueda o pellizco para acercar · toque una pieza</div>
        <div class="clock" id="clock"></div>
      </div>
      <div class="hud">
        <label for="in-explode">Separar <input id="in-explode" type="range" min="0" max="1" step="0.01" value="1"></label>
        <label><input type="checkbox" id="chk-cut"> Corte</label>
        <label><input type="checkbox" id="chk-cage"> Solo la jaula</label>
        <label><input type="checkbox" id="chk-labels" checked> Nombres</label>
        <button class="btn primary" id="btn-play" type="button">Pausar</button>
        <label for="in-speed">Velocidad <select id="in-speed"><option value="0.4">lenta</option><option value="1" selected>normal</option><option value="2">rápida</option></select></label>
        <button class="btn" id="btn-view" type="button">Encuadrar</button>
      </div>
    </div>

    <aside class="side">
      <div class="card" id="step-card"></div>
      <div class="card part-info" id="part-card"></div>
    </aside>
  </div>

  <section style="display:grid;gap:10px">
    <h2>Recorrido de cada magnitud</h2>
    <div class="route"><table>
      <thead><tr><th>Magnitud</th><th>Ley</th><th>Dónde nace</th><th>Por dónde circula</th><th>Dirección del vector</th></tr></thead>
      <tbody>
        <tr><td class="sym"><span class="sw" style="--c:var(--phase-a)"></span><i>i</i>₁</td><td>Red, Kirchhoff</td><td>La red trifásica, a través de la caja de bornes (U1, V1, W1)</td><td>Cables → bornes → bobinas del estator: a lo largo de una ranura, cabeza de bobina, de regreso por la ranura que está un paso polar más allá</td><td>Axial en las ranuras: hacia un lado en un lado de la bobina y hacia el otro en el lado de regreso</td></tr>
        <tr><td class="sym"><span class="sw" style="--c:var(--v-n)"></span><i>H</i>, <i>B</i>, Φ</td><td>Ampère</td><td>Los amperios-vuelta <i>N</i>·<i>i</i>₁ del devanado del estator</td><td>Yugo del estator → diente → entrehierro → núcleo del rotor → entrehierro → diente → yugo. Es un lazo cerrado que gira a <i>n</i><sub>s</sub></td><td>Radial en el entrehierro (sale en N, entra en S); casi tangencial en los yugos</td></tr>
        <tr><td class="sym"><span class="sw" style="--c:var(--v-emf)"></span><i>E</i>, <i>e</i></td><td>Faraday</td><td>Cada barra de la jaula, cuando el campo la barre con velocidad relativa <i>v</i><sub>rel</sub></td><td>Campo eléctrico inducido a lo largo de la barra; su integral es la tensión <i>e</i> ≈ 60 mV</td><td>Axial: <i>v</i><sub>rel</sub> × <i>B</i>. Cambia de sentido entre un polo N y uno S</td></tr>
        <tr><td class="sym"><span class="sw" style="--c:var(--v-cur)"></span><i>i</i>₂</td><td>Ohm, Kirchhoff</td><td>Las barras, empujada por <i>e</i> sobre la resistencia muy baja de la jaula</td><td>Barras bajo un polo → anillo de cortocircuito → barras bajo el polo opuesto → otro anillo. Los anillos llevan unas 2,2 veces la corriente de una barra</td><td>Axial en las barras; tangencial en los anillos</td></tr>
        <tr><td class="sym"><span class="sw" style="--c:var(--v-force)"></span><i>F</i></td><td>Lorentz</td><td>Cada barra con corriente <i>i</i>₂ dentro del campo <i>B</i></td><td>De la barra a las láminas del rotor y de ahí al eje</td><td>Tangencial, en el sentido en que gira el campo, bajo N y bajo S</td></tr>
        <tr><td class="sym"><span class="sw" style="--c:var(--v-tau)"></span>τ</td><td>τ = Σ <i>r</i> × <i>F</i></td><td>La suma de las fuerzas de todas las barras por su radio</td><td>Núcleo del rotor → eje → chaveta → acople → carga</td><td>Axial por la regla de la mano derecha; el eje gira en ese sentido</td></tr>
      </tbody>
    </table></div>
    <p class="note">Escalas exageradas para que se vean: el entrehierro real mide 0,4 mm, la animación va en cámara lenta y el deslizamiento se muestra del 12 % en lugar del 3 % real.</p>
  </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script>
(() => {
  const $ = id => document.getElementById(id);
  const viewer = $("viewer");
  if (!window.THREE || !THREE.OrbitControls) { viewer.insertAdjacentHTML("beforeend", `<div class="nogl">No se pudo cargar el motor 3D. Revise la conexión a internet y recargue la página.</div>`); return; }
  const T = THREE;

  // ---------------------------------------------------------------- textos de cada paso y de cada pieza
  const STEPS = {
    despiece: {
      tag: "Paso 0 · Despiece", title: "El motor real, pieza por pieza",
      where: "La energía entra eléctrica por la caja de bornes, se vuelve campo magnético en el estator, cruza el entrehierro hacia el rotor y sale como par mecánico por el eje.",
      eq: null,
      legend: [],
      nums: [["Potencia típica", "≈ 7,5 kW"], ["Ranuras del estator", "24"], ["Barras del rotor", "28"], ["Entrehierro", "0,4 mm"]],
      note: "Toque una pieza o su nombre para ver de qué está hecha y qué papel cumple. Mueva «Separar» para armar y desarmar el motor.",
      cam: [3.6, 6.4, 13.2], target: [-0.4, 0.7, 0], explode: 1, cut: false, cage: false,
    },
    ampere: {
      tag: "Paso 1 · Ley de Ampère", title: "La corriente del estator crea el campo magnético",
      where: "<b>Dónde:</b> en las bobinas de cobre metidas en las ranuras del estator. El campo que producen recorre el yugo y los dientes del estator, cruza el entrehierro y se cierra por el núcleo del rotor.",
      eq: `∮ <i>H</i>·d<i>l</i> = <i>N</i>·<i>i</i>₁ &nbsp;⇒&nbsp; <i>B</i> ≈ μ₀<i>N i</i>₁ / <i>g</i><small>La circulación de H alrededor de un lazo de flujo es igual a la corriente que encierra (los amperios-vuelta de las ranuras).</small>`,
      legend: [["var(--phase-a)", "arrow", "<b>i₁</b> en las ranuras, color de su fase (A amarillo, B azul, C rojo). La flecha cambia de tamaño y sentido con la corriente alterna."],
               ["var(--phase-b)", "dot", "Puntos que avanzan por las bobinas: el recorrido de la corriente, incluidas las cabezas de bobina."],
               ["var(--v-n)", "arrow", "<b>B</b> saliendo del rotor (polo N) en el entrehierro."],
               ["var(--v-s)", "arrow", "<b>B</b> entrando al rotor (polo S)."],
               ["var(--v-flux)", "", "Líneas de flujo <b>Φ</b>: salen por N, cruzan el entrehierro, recorren el yugo y regresan por S. Giran con el campo."]],
      nums: [["Vueltas por fase N", "44"], ["Corriente de magnetización", "8,1 A"], ["FMM por polo ℱ", "≈ 233 A·v"], ["B pico en el entrehierro", "≈ 0,67 T"]],
      note: "Ampère produce un campo <b>magnético</b> (H y B). El campo <b>eléctrico</b> aparece en el paso 2, cuando ese campo magnético cambia sobre las barras del rotor. Con el corte activado se ve el interior: las tres fases suman un campo que gira.",
      cam: [4.0, 3.5, 5.4], target: [0, 0.3, 0.3], explode: 0, cut: true, cage: false,
    },
    faraday: {
      tag: "Paso 2 · Ley de Faraday", title: "El campo giratorio induce tensión y corriente en la jaula",
      where: "<b>Dónde:</b> en las barras de aluminio de la jaula de ardilla, que están dentro del campo, en el entrehierro. Aquí se sacó el rotor del estator para ver la jaula; las flechas de B representan el campo que le llega desde el estator.",
      eq: `<i>e</i> = (<b><i>v</i></b><sub>rel</sub> × <b><i>B</i></b>)·<i>l</i> &nbsp;·&nbsp; ∮ <b><i>E</i></b>·d<i>l</i> = −dΦ/d<i>t</i><small>El rotor gira más despacio que el campo; la barra "ve" pasar B a la velocidad relativa v<sub>rel</sub> = s·ω<sub>s</sub>·r y aparece un campo eléctrico a lo largo de ella.</small>`,
      legend: [["var(--v-n)", "arrow", "<b>B</b> del campo giratorio (naranja sale, verde azulado entra)."],
               ["var(--v-rel)", "arrow", "<b>v<sub>rel</sub></b>: cómo se mueve la barra respecto al campo."],
               ["var(--v-emf)", "arrow", "<b>e</b> e <b>i₂</b> a lo largo de cada barra: hacia un lado bajo N y hacia el otro bajo S."],
               ["var(--v-cur)", "dot", "Puntos móviles: la corriente inducida recorre las barras y se cierra por los <b>anillos de cortocircuito</b> de los extremos."]],
      nums: [["Deslizamiento real", "3 %"], ["v_rel en la barra", "0,45 m/s"], ["Tensión por barra", "≈ 60 mV"], ["Corriente por barra", "≈ 300 A"]],
